# Postgres — en Railway lo provee automáticamente el plugin de PostgreSQL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rvp

# Contraseña única del organizador para entrar al panel /admin.
ADMIN_PASSWORD=cambia-esto

# Firma de los tokens de sesión del panel admin. Debe tener al menos 32 caracteres de
# entropía real (no una frase corta) — en producción el servidor rechaza arrancar si no la tiene.
JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-de-al-menos-32-caracteres

# Puerto del servidor Express (Railway inyecta PORT automáticamente).
PORT=4000

# Lista de orígenes permitidos por CORS, separados por coma. Si no se define, se usa un
# default seguro (el dominio de Railway + localhost de desarrollo) — NO usar "*" en producción.
# CORS_ORIGIN=https://tu-dominio.up.railway.app,http://localhost:5173

# Solo para desarrollo local: URL del backend que usa el frontend (Vite) cuando corren por separado.
VITE_API_BASE_URL=http://localhost:4000

# NOTA (Railway): server/uploads guarda los comprobantes en disco local. Railway usa contenedores
# efímeros — sin un volumen montado en esa ruta, los archivos se pierden en cada redeploy.

# Envío de certificado por correo al aprobar un pago (server/src/services/emailService.ts).
# Si se omiten cualquiera de las dos, el servicio opera en modo MOCK (solo loguea en consola,
# no falla ni bloquea la aprobación del pago) — útil para desarrollo local.
# GMAIL_USER=tu-cuenta@gmail.com
# GMAIL_APP_PASSWORD=contraseña-de-aplicación-de-16-caracteres-generada-en-gmail

# Motor agéntico del CRM (server/src/services/agentService.ts), vía OpenRouter.
# Si se omite, el agente opera en modo MOCK (respuestas por palabras clave, sin llamar a ningún LLM).
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# Meta WhatsApp Cloud API (server/src/services/metaWhatsAppService.ts, server/src/routes/webhooks.ts).
# Canal prioritario del proyecto para WhatsApp (reemplaza a Baileys/QR). Sin estas variables,
# el envío queda en no-op y el panel de CRM lo refleja como "no configurado".
# META_VERIFY_TOKEN=token-que-tu-eliges-para-el-handshake-del-webhook
# META_WHATSAPP_TOKEN=token-permanente-de-la-app-de-meta
# META_PHONE_NUMBER_ID=id-del-numero-de-telefono-de-whatsapp-business
# META_APP_SECRET=app-secret-de-meta (opcional: habilita verificar X-Hub-Signature-256)
# META_PHONE_NUMBER_ID debe apuntar al número del bot "Biker" (+58 422-0571234), no al de Gustavo.
# ORGANIZER_WHATSAPP_PHONE=584140746270 (opcional: a quién se le envían las alertas del
# sistema —nueva inscripción, escalamiento del bot a humano, verificación de pagos—; por
# defecto usa el número de Gustavo Briceño hardcodeado en metaWhatsAppService.ts)

# Webhook de correos entrantes (server/src/routes/webhooks.ts): POST /api/crm/emails/incoming,
# para integrarlo con Zapier, SendGrid Inbound Parse o un sincronizador IMAP propio.
# El llamador debe enviar el header "x-webhook-token" con este mismo valor.
# EMAIL_WEBHOOK_SECRET=cadena-aleatoria-larga
