# Postgres — en Railway lo provee automáticamente el plugin de PostgreSQL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rvp

# Contraseña única del organizador para entrar al panel /admin.
ADMIN_PASSWORD=cambia-esto

# Firma de los tokens de sesión del panel admin. Debe tener al menos 32 caracteres de
# entropía real (no una frase corta) — en producción el servidor rechaza arrancar si no la tiene.
JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-de-al-menos-32-caracteres

# Puerto del servidor Express (Railway inyecta PORT automáticamente).
PORT=4000

# Lista de orígenes permitidos por CORS, separados por coma. Si no se define, se usa un
# default seguro (el dominio de Railway + localhost de desarrollo) — NO usar "*" en producción.
# CORS_ORIGIN=https://tu-dominio.up.railway.app,http://localhost:5173

# Solo para desarrollo local: URL del backend que usa el frontend (Vite) cuando corren por separado.
VITE_API_BASE_URL=http://localhost:4000

# NOTA (Railway): server/uploads guarda los comprobantes en disco local. Railway usa contenedores
# efímeros — sin un volumen montado en esa ruta, los archivos se pierden en cada redeploy.
